{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(rate(http_requests_total{job=\"eduflow-backend\"}[5m]))", "legendFormat": "请求速率", "refId": "A"}],
      "title": "后端请求速率",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum(rate(http_requests_total{job=\"eduflow-backend\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"eduflow-backend\"}[5m])), 0.001)", "legendFormat": "5xx 错误率", "refId": "A"}],
      "title": "HTTP 5xx 错误率",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_highr_seconds_bucket{job=\"eduflow-backend\"}[5m])) by (le))", "legendFormat": "P95", "refId": "A"}],
      "title": "全局 P95 响应时间",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "id": 4,
      "targets": [{"expr": "eduflow_celery_queue_messages", "legendFormat": "待处理任务", "refId": "A"}],
      "title": "Celery 队列积压",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "id": 5,
      "targets": [{"expr": "increase(eduflow_mysql_slow_queries[5m])", "legendFormat": "5 分钟新增", "refId": "A"}],
      "title": "MySQL 慢查询增长",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "red", "text": "异常"}, "1": {"color": "green", "text": "正常"}}, "type": "value"}], "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "id": 6,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "eduflow_dependency_up", "legendFormat": "{{dependency}}", "refId": "A"}],
      "title": "外部依赖状态",
      "type": "stat"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["eduflow", "fastapi"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "EduFlow 运行概览",
  "uid": "eduflow-overview",
  "version": 1
}
