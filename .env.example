APP_NAME=EduFlow
APP_ENV=development
DEBUG=true
SECRET_KEY=请替换为至少32位的随机字符串
MYSQL_PASSWORD=请替换数据库密码
MYSQL_ROOT_PASSWORD=请替换数据库root密码
DATABASE_URL=mysql+asyncmy://eduflow:eduflow@mysql:3306/eduflow
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=eduflow
MINIO_SECRET_KEY=请替换对象存储密码
MINIO_BUCKET=eduflow
CORS_ORIGINS=["http://localhost:5173"]
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=请替换管理员初始密码
METRICS_ENABLED=true
OBSERVABILITY_PROBE_INTERVAL_SECONDS=15
SLOW_QUERY_THRESHOLD_SECONDS=1
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=eduflow-backend
APP_RELEASE=
